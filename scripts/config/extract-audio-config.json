{
    // Config for extract-tracks.ps1 when -Type is 'Audio'.
    // --- Input/Output ---
    "Type": "Audio", // Track type to extract. 'Audio' or 'Subtitle'.
    "Format": "SOURCE.lang.title.dispo", // Output filename format. Placeholders: SOURCE (base filename), lang (language code), title (stream title/tag), dispo (disposition i.e. 'default', 'forced').
    "Suffix": "", // Suffix appended to the SOURCE placeholder in the output filename. Empty = no suffix.
    "Force": false, // Force overwrite existing extracted files.
    "Recurse": false, // Process folders recursively.

    // --- Executable Paths (Optional) ---
    "FfmpegPath": "", // Optional: Path to ffmpeg.exe. Auto-detected if empty or omitted.
    "FfprobePath": "", // Optional: Path to ffprobe.exe. Auto-detected if empty or omitted.
    "DisableWhereSearch": false, // Disable searching for ffmpeg/ffprobe in PATH.

    // --- Other ---
    "Verbose": false, // Verbose output (detailed progress and information).
    "Concise": false // Concise output (only progress shown).
}